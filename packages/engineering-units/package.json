{
  "name": "@ogwusearch/engineering-units",
  "version": "0.1.0",
  "description": "Physical dimensions, units, quantities, and deterministic unit conversion infrastructure for Ogwusearch Engineering.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ogwusearch/engineering-types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ogwusearch/Ogwusearch.git",
    "directory": "packages/engineering-units"
  },
  "publishConfig": {
    "access": "public"
  }
}
