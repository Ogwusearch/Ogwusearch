{
  "name": "@ogwusearch/engineering-telemetry",
  "version": "0.1.0",
  "description": "Framework-free telemetry infrastructure for engineering applications, calculations, testing, and operational events.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
