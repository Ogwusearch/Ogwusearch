{
  "name": "@ogwusearch/engineering-types",
  "version": "0.1.0",
  "description": "Shared engineering contracts and type definitions for the Ogwusearch Engineering platform.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
