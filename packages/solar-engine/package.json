{
  "name": "@ogwusearch/solar-engine",
  "version": "0.1.0",
  "description": "Domain-specific solar engineering calculations and validation built on the Ogwusearch Engineering foundation.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ogwusearch/battery-engine": "workspace:*",
    "@ogwusearch/engineering-core": "workspace:*",
    "@ogwusearch/engineering-types": "workspace:*",
    "@ogwusearch/engineering-units": "workspace:*",
    "@ogwusearch/engineering-validation": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ogwusearch/Ogwusearch.git",
    "directory": "packages/solar-engine"
  },
  "publishConfig": {
    "access": "public"
  }
}
